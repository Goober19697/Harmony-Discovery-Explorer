# Backend (copy to backend/.env for local development)
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-development-value
DATABASE_URL=postgresql:///harmony_discovery_explorer
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
API_HOST=127.0.0.1
API_PORT=5001
FLASK_DEBUG=true
LOG_LEVEL=INFO

# Frontend (exposed in the browser; never put secrets in VITE_* variables)
VITE_API_BASE_URL=http://localhost:5001/api

# Optional piano sample host override. Files must use Tone.js sample names such
# as A1.mp3, C4.mp3, Ds3.mp3, and Fs5.mp3.
# VITE_SAMPLE_BASE_URL=https://tonejs.github.io/audio/salamander/
