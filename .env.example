# Harmony Discovery Explorer — environment variables

# Required in production. Generate a long random value; never commit it.
# SECRET_KEY=replace-with-a-long-random-secret

# Local HTTP development uses false. Set true in HTTPS production.
SESSION_COOKIE_SECURE=false

# Flask's local development bind address and port.
API_HOST=127.0.0.1
API_PORT=5001
# Used only when running backend/app.py directly.
FLASK_DEBUG=true

# Exact React origin allowed to make credentialed API requests.
FRONTEND_ORIGIN=http://localhost:5173

# Flask API URL used by the React build. Keep the hostname aligned with the
# frontend hostname during local development so SameSite cookies work.
VITE_API_BASE_URL=http://localhost:5001

# Where the piano samples are fetched from. Defaults to the Salamander
# grand piano set on the Tone.js CDN. Point this at your own folder of
# samples (served over HTTP) if you want a different instrument by default.
# Files must be named like A1.mp3, C4.mp3, Ds3.mp3, Fs5.mp3, etc.
# VITE_SAMPLE_BASE_URL=https://tonejs.github.io/audio/salamander/
